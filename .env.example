# Last.fm API Key
# Get your API key at: https://www.last.fm/api/account/create
NEXT_PUBLIC_LASTFM_API_KEY=your_lastfm_api_key_here

# YouTube Data API v3 Key (server-side only, not exposed to client)
# Get your API key at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here
